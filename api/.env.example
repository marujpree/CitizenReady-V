# API server. Copy this file to .env and fill in real values. Never commit .env.
PORT=3001
# The web app's address, allowed to call this API (CORS)
WEB_ORIGIN=http://localhost:5173

# Supabase API URL. Local: run `npx supabase status` and copy the API URL
SUPABASE_URL=http://localhost:54321
# Supabase SECRET key (starts with sb_secret_). SERVER ONLY, never put it in web/
SUPABASE_SECRET_KEY=replace-me

# Optional. Groq API key from console.groq.com for Whisper speech-to-text.
# Leave it out and the app uses the browser's built-in speech recognition instead.
# GROQ_API_KEY=replace-me

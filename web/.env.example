# Web app. Copy this file to .env and fill in real values. Never commit .env.
# Everything here ends up in the browser, so only put public values in it.

# Address of our Express API
VITE_API_URL=http://localhost:3001

# Supabase API URL. Local: run `npx supabase status` and copy the API URL
VITE_SUPABASE_URL=http://localhost:54321
# Supabase PUBLISHABLE key (starts with sb_publishable_). Safe for the browser
VITE_SUPABASE_PUBLISHABLE_KEY=replace-me
